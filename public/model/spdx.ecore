<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="spdx" nsURI="http://spdx.org/rdf/terms#" nsPrefix="spdx">
  <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
    <details key="validationDelegates" value="http://www.eclipse.org/fennec/m2x/ocl/1.0"/>
  </eAnnotations>
  <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
    <details key="documentation" value="&#xA;      SPDX XML Schema (relevant parts for DCAT-AP.de 3.0)&#xA;      http://spdx.org/rdf/terms#&#xA;      spdx:Checksum (DCAT-AP.de 3.0 §4.12) is referenced from dcat:Distribution via spdx:checksum.&#xA;    "/>
  </eAnnotations>
  <eClassifiers xsi:type="ecore:EClass" name="Checksum" eSuperTypes="rdf.ecore#//IdentifiedResource">
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="AlgorithmIsIri"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/fennec/m2x/ocl/1.0">
      <details key="AlgorithmIsIri" value="self.algorithm = null or self.algorithm.matches('[A-Za-z][A-Za-z0-9+.\\-]*:\\S*')"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="&#xA;        spdx:Checksum — a value that allows the content of a file to be&#xA;        verified (DCAT-AP.de 3.0 §4.12). Referenced from dcat:Distribution&#xA;        via spdx:checksum. Carries the algorithm used and the resulting value.&#xA;      "/>
    </eAnnotations>
    <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
      <details key="name" value="Checksum"/>
      <details key="kind" value="elementOnly"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="checksumValue" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2003/XMLType#//HexBinary">
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="element"/>
        <details key="name" value="checksumValue"/>
        <details key="namespace" value="##targetNamespace"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="nodeID" eType="ecore:EDataType http://www.eclipse.org/emf/2003/XMLType#//NCName">
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="attribute"/>
        <details key="name" value="nodeID"/>
        <details key="namespace" value="http://www.w3.org/1999/02/22-rdf-syntax-ns#"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="algorithm" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2003/XMLType#//AnyURI">
      <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
        <details key="kind" value="element"/>
        <details key="name" value="algorithm"/>
        <details key="namespace" value="##targetNamespace"/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
</ecore:EPackage>
