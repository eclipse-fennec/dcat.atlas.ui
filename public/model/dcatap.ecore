  <eClassifiers xsi:type="ecore:EClass" name="DcatResource" abstract="true" eSuperTypes="rdf.ecore#//IdentifiedResource">
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="HasIdentity ThemeIsIri TypeIsIri AccessRightsIsIri HasPolicyIsIri QualifiedAttributionIsIri RelationIsIri IsReferencedByIsIri LanguageIsIri ContributorIDIsIri ApplicableLegislationIsIri PoliticalGeocodingLevelURIIsIri"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/fennec/m2x/ocl/1.0">
      <details key="HasIdentity" value="self.about &lt;> null and self.about.size() > 0"/>
      <details key="ThemeIsIri" value="self.theme->forAll(v | v.matches('[A-Za-z][A-Za-z0-9+.\\-]*:\\S*'))"/>
      <details key="TypeIsIri" value="self.type->forAll(v | v.matches('[A-Za-z][A-Za-z0-9+.\\-]*:\\S*'))"/>
      <details key="AccessRightsIsIri" value="self.accessRights = null or self.accessRights.matches('[A-Za-z][A-Za-z0-9+.\\-]*:\\S*')"/>
      <details key="HasPolicyIsIri" value="self.hasPolicy = null or self.hasPolicy.matches('[A-Za-z][A-Za-z0-9+.\\-]*:\\S*')"/>
      <details key="QualifiedAttributionIsIri" value="self.qualifiedAttribution->forAll(v | v.matches('[A-Za-z][A-Za-z0-9+.\\-]*:\\S*'))"/>
      <details key="RelationIsIri" value="self.relation->forAll(v | v.matches('[A-Za-z][A-Za-z0-9+.\\-]*:\\S*'))"/>
      <details key="IsReferencedByIsIri" value="self.isReferencedBy->forAll(v | v.matches('[A-Za-z][A-Za-z0-9+.\\-]*:\\S*'))"/>
      <details key="LanguageIsIri" value="self.language->forAll(v | v.matches('[A-Za-z][A-Za-z0-9+.\\-]*:\\S*'))"/>
      <details key="ContributorIDIsIri" value="self.contributorID->forAll(v | v.matches('[A-Za-z][A-Za-z0-9+.\\-]*:\\S*'))"/>
      <details key="ApplicableLegislationIsIri" value="self.applicableLegislation->forAll(v | v.matches('[A-Za-z][A-Za-z0-9+.\\-]*:\\S*'))"/>
      <details key="PoliticalGeocodingLevelURIIsIri" value="self.politicalGeocodingLevelURI->forAll(v | v.matches('[A-Za-z][A-Za-z0-9+.\\-]*:\\S*'))"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="&#xA;        dcat:Resource represents a dataset, a data service or any other resource&#xA;        that may be described by a metadata record in a catalog.&#xA;&#xA;        This class is not intended to be used directly, but is the parent class of dcat:Dataset,&#xA;        dcat:DataService and dcat:Catalog.&#xA;&#xA;        Member items in a catalog should be members of one of the sub-classes, or of a&#xA;        sub-class of these, or of a sub-class of dcat:Resource defined in a&#xA;        DCAT profile or other DCAT application.&#xA;&#xA;        dcat:Resource is effectively an extension point for defining&#xA;        a catalog of any kind of resource. dcat:Dataset and dcat:DataService&#xA;        can be used for datasets and services which are not documented in any catalog.&#xA;      "/>
    </eAnnotations>
    <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
      <details key="name" value="ResourceType"/>
      <details key="kind" value="elementOnly"/>
    </eAnnotations>
