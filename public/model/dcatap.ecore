  <eClassifiers xsi:type="ecore:EClass" name="Dataset" eSuperTypes="#//DcatResource">
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="HasDescription AccrualPeriodicityIsIri WasGeneratedByIsIri HasVersionIsIri"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/fennec/m2x/ocl/1.0">
      <details key="HasDescription" value="self.description-&gt;notEmpty()"/>
      <details key="AccrualPeriodicityIsIri" value="self.accrualPeriodicity = null or self.accrualPeriodicity.matches('[A-Za-z][A-Za-z0-9+.\\-]*:\\S*')"/>
      <details key="WasGeneratedByIsIri" value="self.wasGeneratedBy->forAll(v | v.matches('[A-Za-z][A-Za-z0-9+.\\-]*:\\S*'))"/>
      <details key="HasVersionIsIri" value="self.hasVersion->forAll(v | v.matches('[A-Za-z][A-Za-z0-9+.\\-]*:\\S*'))"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="&#xA;        dcat:Dataset represents a dataset. A dataset is a collection of data, published or curated by a single agent.&#xA;        Data comes in many forms including numbers, words, pixels, imagery, sound and other multi-media, and potentially&#xA;        other types, any of which might be collected into a dataset.&#xA;      "/>
    </eAnnotations>
    <eAnnotations source="http:///org/eclipse/emf/ecore/util/ExtendedMetaData">
