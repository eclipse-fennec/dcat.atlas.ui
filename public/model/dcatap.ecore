  <eClassifiers xsi:type="ecore:EClass" name="Catalog" eSuperTypes="#//Dataset">
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="ThemeTaxonomyIsIri HasPartIsIri HomepageIsIri"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/fennec/m2x/ocl/1.0">
      <details key="ThemeTaxonomyIsIri" value="self.themeTaxonomy->forAll(v | v.matches('[A-Za-z][A-Za-z0-9+.\\-]*:\\S*'))"/>
